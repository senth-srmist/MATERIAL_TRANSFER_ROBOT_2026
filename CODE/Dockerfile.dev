# ==============================================================================
# Dockerfile.prod - Optimized Build with Parallel Stages
# ==============================================================================
#
# Build Graph:
#
#        pkg-extract (alpine)
#               │
#       ┌───────┴───────┐
#       │               │
#       ▼               ▼
#   apt+rosdep      pip-download
#       │               │
#       │   PARALLEL    │
#       └───────┬───────┘
#               │
#               ▼
#            final
#        (merge both)
#
# Build with:
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.prod -t material-transfer-robot:latest .
#
# ==============================================================================

# ==============================================================================
# Stage 0: Extract package.xml files only (lightweight, fast)
# ==============================================================================
FROM alpine:3.18 AS pkg-extract

COPY ./ros_ws/src /tmp/src
RUN mkdir -p /tmp/pkg_xmls && \
    find /tmp/src -name "package.xml" -exec cp --parents {} /tmp/pkg_xmls \;

# ==============================================================================
# Stage 1: ROS apt packages + rosdep (parallel with pip)
# ==============================================================================
ARG TARGETARCH
FROM ghcr.io/tejasmk-tkp/material-transfer-robot-base-${TARGETARCH}:latest AS ros-deps

# rosdep dependencies from package.xml - changes when package.xml changes
COPY --from=pkg-extract /tmp/pkg_xmls/tmp/src /tmp/pkg_xmls/src

RUN apt-get update && \
    rosdep update && \
    rosdep install --from-paths /tmp/pkg_xmls --ignore-src -r -y && \
    rm -rf /tmp/pkg_xmls && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ==============================================================================
# Stage 2: Python dependencies (parallel with ros-deps)
# ==============================================================================
ARG TARGETARCH
FROM ghcr.io/tejasmk-tkp/material-transfer-robot-base-${TARGETARCH}:latest AS pip-deps

COPY requirements.txt /tmp/requirements.txt

RUN pip install --no-cache-dir --upgrade -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# ==============================================================================
# Final Stage: Combine both parallel stages
# ==============================================================================
FROM ros-deps AS final

ARG USERNAME=myrobo
ARG UID=1000
ARG GID=1000

# Copy pip-installed Python packages from parallel stage
COPY --from=pip-deps /usr/local/lib/python3.10/dist-packages /usr/local/lib/python3.10/dist-packages
COPY --from=pip-deps /usr/local/bin /usr/local/bin

# User configuration
RUN echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Workspace & shell configuration
WORKDIR /workspace/ros_ws

USER root
RUN echo "source /opt/ros/humble/setup.bash" > /home/$USERNAME/.bashrc && \
    echo "if [ -f /workspace/ros_ws/install/setup.bash ]; then source /workspace/ros_ws/install/setup.bash; fi" >> /home/$USERNAME/.bashrc && \
    chown $USERNAME:$USERNAME /home/$USERNAME/.bashrc

USER $USERNAME
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
