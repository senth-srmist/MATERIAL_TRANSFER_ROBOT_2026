# ==============================================================================
# Stage 1: Extract package.xml files only
#
# This stage copies all source but only to extract package.xml files.
# The extracted files are passed to stage 2. Since stage 2 only COPY's
# the extracted package.xml files, the rosdep layer is cached unless
# a package.xml actually changes.
# ==============================================================================
FROM alpine:3.18 AS pkg-extract

COPY ./ros_ws/src /tmp/src
RUN mkdir -p /tmp/pkg_xmls && \
    find /tmp/src -name "package.xml" -exec cp --parents {} /tmp/pkg_xmls \;

# ==============================================================================
# Stage 2: Production Image
# ==============================================================================
FROM material-transfer-robot-base:latest

ARG USERNAME=myrobo
ARG UID=1000
ARG GID=1000
ARG TARGETARCH

# ==============================================================================
# User Configuration
# ==============================================================================
RUN echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ==============================================================================
# ROS 2 Dependencies
#
# Only package.xml files are copied from stage 1.
# This layer is cached unless a package.xml changes —
# editing .py/.cpp/config files does NOT trigger a rebuild.
# ==============================================================================

RUN rosdep update

# Copy only the extracted package.xml files from stage 1
COPY --from=pkg-extract /tmp/pkg_xmls/tmp/src /tmp/pkg_xmls/src

RUN set -e && \
    apt-get update && \
    rosdep install --from-paths /tmp/pkg_xmls --ignore-src -r -y && \
    apt-get install --no-install-recommends -y \
        ros-humble-navigation2 \
        ros-humble-nav2-bringup \
        ros-humble-joy \
        ros-humble-teleop-twist-joy \
        ros-humble-robot-localization \
        ros-humble-teleop-twist-keyboard \
        ros-humble-twist-mux && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/pkg_xmls

# ==============================================================================
# Python Dependencies
# ==============================================================================
RUN pip install --upgrade \
    numpy==1.26.4 \
    scipy==1.15.3 \
    opencv-python==4.11.0.86 \
    opencv-contrib-python==4.11.0.86 \
    PyYAML==6.0.3 \
    pyserial==3.5 \
    pandas==2.3.3 \
    matplotlib==3.10.8 \
    Jetson.GPIO==2.1.12

# ==============================================================================
# Workspace & User Configuration
# ==============================================================================
WORKDIR /workspace/ros_ws

USER root
RUN echo "source /opt/ros/humble/setup.bash" > /home/$USERNAME/.bashrc && \
    echo "if [ -f /workspace/ros_ws/install/setup.bash ]; then source /workspace/ros_ws/install/setup.bash; fi" >> /home/$USERNAME/.bashrc && \
    chown $USERNAME:$USERNAME /home/$USERNAME/.bashrc

USER $USERNAME

CMD ["bash"]
