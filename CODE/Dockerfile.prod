# ==============================================================================
# Dockerfile.prod - Production Image with Dependencies
# ==============================================================================
#
# Build Graph:
#
#        pkg-extract (alpine)
#               │
#       ┌───────┴────────────────┬───────────────────┐
#       │                        │                   │
#       ▼                        ▼                   ▼
#   AMD64: rosdep           ARM64: source        pip-deps
#   (apt install)           (rosinstall_generator  (both)
#                            + colcon build)
#       │                        │                   │
#       └────────────────────────┴───────────────────┘
#                                │
#                                ▼
#                             final
#
# AMD64: Uses rosdep → apt to install ROS dependencies
# ARM64: Uses rosinstall_generator to get sources, then builds them
#
# Build with:
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.prod -t material-transfer-robot:latest .
#
# ==============================================================================

# ==============================================================================
# Stage 0: Extract package.xml files only (lightweight, fast)
# ==============================================================================
FROM alpine:3.18 AS pkg-extract

RUN apk add --no-cache python3 py3-pip
RUN pip3 install --break-system-packages catkin_pkg

COPY ./ros_ws/src /tmp/src

# Extract package.xml files
RUN mkdir -p /tmp/pkg_xmls && \
    find /tmp/src -name "package.xml" -exec cp --parents {} /tmp/pkg_xmls \;

# Parse all package.xml and extract unique ROS dependencies
# Output: /tmp/ros_deps.txt with one package name per line
RUN python3 -c "\
import os; \
import xml.etree.ElementTree as ET; \
deps = set(); \
[deps.update([elem.text.strip() for tag in ['depend', 'build_depend', 'exec_depend', 'build_export_depend'] for elem in ET.parse(os.path.join(root, f)).findall(tag) if elem.text and elem.text.strip() and not elem.text.strip().startswith('python')]) for root, dirs, files in os.walk('/tmp/src') for f in files if f == 'package.xml']; \
open('/tmp/ros_deps.txt', 'w').write('\n'.join(sorted(deps))); \
print(f'Found {len(deps)} ROS dependencies')"

RUN cat /tmp/ros_deps.txt

# ==============================================================================
# Stage 1a: AMD64 - Use rosdep (apt-based)
# ==============================================================================
FROM material-transfer-robot-base:latest AS ros-deps-amd64

COPY --from=pkg-extract /tmp/pkg_xmls/tmp/src /tmp/pkg_xmls/src

RUN apt-get update && \
    rosdep update && \
    rosdep install --from-paths /tmp/pkg_xmls --ignore-src -r -y && \
    rm -rf /tmp/pkg_xmls && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ==============================================================================
# Stage 1b: ARM64 - Build from source using rosinstall_generator
# ==============================================================================
FROM material-transfer-robot-base:latest AS ros-deps-arm64

# Install tools needed for source builds
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-vcstool \
        python3-rosinstall-generator \
        python3-rosdep && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy the dependency list
COPY --from=pkg-extract /tmp/ros_deps.txt /tmp/ros_deps.txt

# Generate repos file and build all dependencies from source
WORKDIR /root/rosdeps_ws

RUN /bin/bash -c '\
    source /opt/ros/humble/install/setup.bash && \
    source /root/ros_deps_ws/install/local_setup.bash 2>/dev/null || true && \
    \
    # Read deps and filter out ones already installed \
    DEPS_TO_BUILD="" && \
    while IFS= read -r dep || [ -n "$dep" ]; do \
        # Skip empty lines \
        [ -z "$dep" ] && continue; \
        # Check if package already exists \
        if ! ros2 pkg list 2>/dev/null | grep -q "^${dep}$"; then \
            DEPS_TO_BUILD="$DEPS_TO_BUILD $dep"; \
        else \
            echo "Already installed: $dep"; \
        fi \
    done < /tmp/ros_deps.txt && \
    \
    # If no deps to build, exit \
    if [ -z "$DEPS_TO_BUILD" ]; then \
        echo "All dependencies already installed!"; \
        mkdir -p /root/rosdeps_ws/install; \
        exit 0; \
    fi && \
    \
    echo "Dependencies to build: $DEPS_TO_BUILD" && \
    \
    # Generate repos file for missing deps \
    rosinstall_generator $DEPS_TO_BUILD \
        --rosdistro humble \
        --deps \
        --tar > /tmp/deps.repos 2>/dev/null || true && \
    \
    # Check if repos file has content \
    if [ ! -s /tmp/deps.repos ] || ! grep -q "repositories:" /tmp/deps.repos; then \
        echo "No source repos found, deps may be in base image"; \
        mkdir -p /root/rosdeps_ws/install; \
        exit 0; \
    fi && \
    \
    # Import sources \
    mkdir -p src && \
    vcs import src < /tmp/deps.repos || true && \
    \
    # Skip if no sources were imported \
    if [ -z "$(ls -A src 2>/dev/null)" ]; then \
        echo "No sources to build"; \
        mkdir -p /root/rosdeps_ws/install; \
        exit 0; \
    fi && \
    \
    # Build (skip tests - C++ compatibility issues on Bionic/GCC7) \
    colcon build \
        --parallel-workers $(nproc) \
        --symlink-install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
        --event-handlers console_direct+ \
    || echo "Some packages may have failed, continuing..." \
'

# ==============================================================================
# Stage 2: Python dependencies (parallel with ros-deps)
# ==============================================================================
FROM material-transfer-robot-base:latest AS pip-deps

ARG TARGETARCH

COPY requirements.txt /tmp/requirements.txt

# Create unpinned requirements for ARM64 (Python 3.6 can't use latest versions)
# AMD64 uses pinned versions, ARM64 uses unpinned (pip resolves compatible versions)
# ARM64: Skip opencv (not needed), skip PyYAML (system package conflict)
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        sed 's/==.*//' /tmp/requirements.txt | \
        grep -v 'opencv' | \
        grep -v 'PyYAML' > /tmp/requirements_compat.txt && \
        pip3 install --no-cache-dir --ignore-installed --default-timeout=100 --retries 5 -r /tmp/requirements_compat.txt; \
    else \
        pip3 install --no-cache-dir --upgrade -r /tmp/requirements.txt; \
    fi && \
    rm -f /tmp/requirements.txt /tmp/requirements_compat.txt

# ==============================================================================
# Stage 3: Platform selector for ros-deps
# ==============================================================================
FROM ros-deps-${TARGETARCH} AS ros-deps

ARG TARGETARCH

# ==============================================================================
# Final Stage: Combine ros-deps + pip-deps
# ==============================================================================
FROM ros-deps AS final

ARG TARGETARCH
ARG USERNAME=myrobo
ARG UID=1000
ARG GID=1000

# Copy pip packages - handle different Python versions
# ARM64 (Bionic) uses Python 3.6, AMD64 (Jammy) uses Python 3.10
RUN if [ "$TARGETARCH" = "amd64" ]; then \
        echo "AMD64: Python 3.10"; \
    else \
        echo "ARM64: Python 3.6"; \
    fi

COPY --from=pip-deps /usr/local/lib/python3.*/dist-packages /tmp/pip-packages/
RUN cp -r /tmp/pip-packages/* /usr/local/lib/python3.*/dist-packages/ 2>/dev/null || true && \
    rm -rf /tmp/pip-packages

COPY --from=pip-deps /usr/local/bin /usr/local/bin

# User configuration
RUN echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Workspace setup
WORKDIR /workspace/ros_ws

# Shell configuration with all workspaces sourced
USER root
RUN if [ "$TARGETARCH" = "amd64" ]; then \
        echo 'source /opt/ros/humble/setup.bash' > /home/$USERNAME/.bashrc; \
    else \
        echo 'source /opt/ros/humble/install/setup.bash' > /home/$USERNAME/.bashrc && \
        echo 'source /root/ros_deps_ws/install/local_setup.bash 2>/dev/null || true' >> /home/$USERNAME/.bashrc && \
        echo 'source /root/rosdeps_ws/install/local_setup.bash 2>/dev/null || true' >> /home/$USERNAME/.bashrc; \
    fi && \
    echo 'if [ -f /workspace/ros_ws/install/setup.bash ]; then source /workspace/ros_ws/install/setup.bash; fi' >> /home/$USERNAME/.bashrc && \
    chown $USERNAME:$USERNAME /home/$USERNAME/.bashrc

USER $USERNAME

CMD ["bash"]
