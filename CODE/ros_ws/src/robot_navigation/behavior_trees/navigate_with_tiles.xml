<!--
  navigate_with_tiles.xml

  Navigation behavior tree with tile switching.
  TileCheckAction runs continuously during navigation via ReactiveSequence,
  so tile boundaries are detected even while FollowPath is active.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">

        <!--
          ReactiveSequence re-ticks ALL children every tick.
          - TileCheckAction checks zones every tick (returns SUCCESS when idle,
            RUNNING during async switch). When RUNNING, ReactiveSequence
            halts FollowPath, pausing the robot during map swap.
          - The inner PipelineSequence handles normal plan+follow.
        -->
        <ReactiveSequence name="NavigateWithTileCheck">
          <TileCheckAction name="tile_check" config_file=""/>
          <PipelineSequence name="PlanAndFollow">
            <RateController hz="1.0">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            </RateController>
            <FollowPath path="{path}" controller_id="FollowPath"/>
          </PipelineSequence>
        </ReactiveSequence>

      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
