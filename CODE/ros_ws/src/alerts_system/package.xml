<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>alerts_system</name>
  <version>1.0.0</version>
  <description> Simple text-to-speech service. Any node can call /speak with a message. </description>
  <maintainer email="tejas@example.com">Tejas</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclpy</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>pulseaudio-utils</exec_depend>
  <exec_depend>libasound2-plugins</exec_depend>
  <exec_depend>alsa-utils</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
