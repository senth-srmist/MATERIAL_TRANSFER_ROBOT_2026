<?xml version="1.0"?>
<!--
  robot.urdf.xacro

  TF Tree (EKF-owned):
    map → odom → base_link → zed_camera_link → zed_camera_center → zed_left_camera_frame
                           ├── left_wheel             → zed_right_camera_frame
                           ├── right_wheel            → zed_imu_link
                           └── ground                 → (other ZED internal frames)

  Frame convention:
    - base_link is the robot body root (EKF publishes odom→base_link)
    - zed_camera_link is a child of base_link via static_transform_publisher
      (in robot_description.launch.py: xyz=0.174 0 -0.05, rpy=0 0 0)
    - ZED SDK publishes its internal camera frames as children of zed_camera_link via /tf_static
    - ZED config: publish_tf: false (EKF owns the TF chain)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="material_transfer_robot">
  <xacro:property name="body_length" value="0.40"/>
  <xacro:property name="body_width" value="0.30"/>
  <xacro:property name="body_height" value="0.70"/>
  <xacro:property name="camera_height" value="0.746"/>
  <xacro:property name="camera_forward" value="0.174"/>
  <xacro:property name="camera_tilt" value="0.5236"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_y_offset" value="0.063"/>
  <!-- ZED CAMERA LINK — child of base_link, forward and down from robot center -->
  <link name="zed_camera_link"/>
  <joint name="base_to_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_camera_link"/>
    <!-- Inverse of old camera_to_base_joint: +forward, -up -->
    <origin xyz="${camera_forward} 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>
  <!-- Camera mount frame: true physical pose (height + tilt) -->
  <link name="camera_mount"/>
  <joint name="base_to_camera_mount" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <!-- Raise by camera_height and apply tilt (no forward offset here) -->
    <origin xyz="${camera_forward} 0 ${camera_height}" rpy="0 ${camera_tilt} 0"/>
  </joint>
  <!-- Ground frame at floor level -->
  <link name="ground"/>
  <joint name="base_to_ground" type="fixed">
    <parent link="base_link"/>
    <child link="ground"/>
    <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <!-- Body center is at half height above base_link origin (ground level) -->
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
    </collision>
  </link>
  <!-- LEFT WHEEL -->
  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${body_width/2 + wheel_y_offset} 0" rpy="${-pi/2} 0 0"/>
  </joint>
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>
  <!-- RIGHT WHEEL -->
  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 ${-body_width/2 - wheel_y_offset} 0" rpy="${-pi/2} 0 0"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>
</robot>
