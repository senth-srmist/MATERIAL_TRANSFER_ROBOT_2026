<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diff_drive_controller</name>
  <version>0.0.1</version>
  <description> Differential drive controllers for Cytron SmartDuo motor driver: simple serial
    control and Nav2-compatible base controller </description>
  <maintainer email="lk9092@srmist.edu.in">lalithesh</maintainer>
  <license>Apache-2.0</license>
  <!-- Runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-tkinter</exec_depend>
  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
