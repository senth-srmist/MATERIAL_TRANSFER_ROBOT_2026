<?xml version="1.0"?>
<!--
  robot.urdf.xacro

  TF Tree (ZED-rooted, no odom_base_publisher):
    map → odom → zed_left_camera_frame → zed_camera_link → base_link → left_wheel
                                        → zed_imu_link              → right_wheel
                                        → zed_right_camera_frame
                                        → zed_camera_center
                                        → (other ZED internal frames)

  Frame convention:
    - zed_camera_link is the ZED's gravity-aligned root (two_d_mode + set_gravity_as_origin)
    - base_link hangs off zed_camera_link, offset back and down to ground level
    - No tilt in the joint — ZED gravity alignment already levels the frame
    - Wheel visuals are children of base_link as before

  ZED config: publish_tf: true, two_d_mode: true, set_gravity_as_origin: true
  No odom_base_publisher needed — ZED owns map→odom→zed_left_camera_frame→zed_camera_link
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="material_transfer_robot">
  <xacro:property name="body_length" value="0.40" />
  <xacro:property name="body_width" value="0.30" />
  <xacro:property name="body_height" value="0.70" />
  <xacro:property name="camera_height" value="0.746" />
  <!-- camera is this far above ground -->
  <xacro:property name="camera_forward" value="0.174" />
  <!-- camera is this far forward of robot center -->
  <xacro:property name="wheel_radius" value="0.05" />
  <xacro:property name="wheel_width" value="0.026" />
  <xacro:property name="wheel_y_offset" value="0.063" />
  <!-- ZED CAMERA LINK — root of URDF tree, owned by ZED SDK TF broadcaster -->
  <!-- Declared here so robot_state_publisher knows it exists as a root -->
  <link name="zed_camera_link" />
  <!-- BASE LINK — child of zed_camera_link, offset back to robot center and down to ground -->
  <joint name="camera_to_base_joint" type="fixed">
    <parent link="zed_camera_link" />
    <child link="base_link" />
    <!-- Inverse of original mount offset: back by camera_forward, down by camera_height -->
    <!-- No RPY — ZED gravity alignment (two_d_mode + set_gravity_as_origin) levels the frame -->
    <origin xyz="${-camera_forward} 0 ${-camera_height}" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
      <!-- Body center is at half height above base_link origin (ground level) -->
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0" />
      <material name="grey">
        <color rgba="0.6 0.6 0.6 0.8" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0" />
    </collision>
  </link>
  <!-- LEFT WHEEL -->
  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 ${body_width/2 + wheel_y_offset} 0" rpy="${-pi/2} 0 0" />
  </joint>
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>
  <!-- RIGHT WHEEL -->
  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 ${-body_width/2 - wheel_y_offset} 0" rpy="${-pi/2} 0 0" />
  </joint>
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>
</robot>
