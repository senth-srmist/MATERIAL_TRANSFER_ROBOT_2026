<?xml version="1.0"?>
<!--
  robot.urdf.xacro
  
  TF Tree after this URDF + ZED:
    map → odom → zed_camera_link → base_link → wheels
    (ZED)  (ZED)     (ZED)           (URDF)     (URDF)
    
  ZED publishes: map → odom → zed_camera_link
  URDF publishes: zed_camera_link → base_link → wheels
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="material_transfer_robot">

  <!-- ============================================ -->
  <!-- ROBOT PARAMETERS                            -->
  <!-- ============================================ -->
  
  <!-- Robot body dimensions (meters) - for visualization -->
  <xacro:property name="body_length" value="0.40"/>
  <xacro:property name="body_width" value="0.40"/>
  <xacro:property name="body_height" value="0.70"/>
  
  <!-- Camera to base_link offset (zed_camera_link → base_link) -->
  <!-- These match your original static_transform_publisher values -->
  <xacro:property name="base_x" value="-0.15"/>     <!-- base_link is 15cm BEHIND camera -->
  <xacro:property name="base_y" value="0.00"/>      <!-- Centered -->
  <xacro:property name="base_z" value="-0.70"/>     <!-- base_link is 70cm BELOW camera -->
  
  <!-- Camera rotation relative to base -->
  <xacro:property name="base_roll" value="0.0"/>
  <xacro:property name="base_pitch" value="-0.523"/>  <!-- -30° (camera tilted down) -->
  <xacro:property name="base_yaw" value="0.0"/>
  
  <!-- Wheel parameters -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_y_offset" value="0.20"/>

  <!-- ============================================ -->
  <!-- ZED CAMERA LINK (root of URDF, child of odom via ZED) -->
  <!-- ============================================ -->
  <link name="zed_camera_link"/>

  <!-- ============================================ -->
  <!-- BASE LINK - Connected to camera             -->
  <!-- ============================================ -->
  <joint name="camera_to_base_joint" type="fixed">
    <parent link="zed_camera_link"/>
    <child link="base_link"/>
    <origin xyz="${base_x} ${base_y} ${base_z}" 
            rpy="${base_roll} ${base_pitch} ${base_yaw}"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- ============================================ -->
  <!-- WHEELS                                      -->
  <!-- ============================================ -->
  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${wheel_y_offset} ${wheel_radius}" rpy="-1.5708 0 0"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -${wheel_y_offset} ${wheel_radius}" rpy="-1.5708 0 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

</robot>
